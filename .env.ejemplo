# Plantilla de credenciales locales. Copiala a .env y cambialas.
#
# .env esta en .gitignore: NUNCA se versiona. Esta plantilla si, porque
# no contiene secretos reales y sirve de documentacion.
#
#   cp .env.ejemplo .env
#
# Para generar una contrasena de la base:
#   openssl rand -base64 24

# --- Base de datos ---
POSTGRES_DB=microservicio
POSTGRES_USER=microservicio
POSTGRES_PASSWORD=cambia-esto-por-una-contrasena-aleatoria

# Credenciales que usa la API para conectar. Deben coincidir con las de
# arriba, pero se declaran aparte para poder differentiating el rol de la
# aplicacion del propietario de la base. En produccion lo normal es que
# NO coincidan: la aplicacion no necesita ser propietaria del esquema.
DB_USER=microservicio
DB_PASSWORD=cambia-esto-por-una-contrasena-aleatoria

# --- Seguridad de la API ---
# Vacia = API sin autenticacion (util en desarrollo).
# Para activarla: rellena ambas y pon SEGURIDAD_ACTIVADA=true
SEGURIDAD_ACTIVADA=false
SEGURIDAD_CLAVE=
